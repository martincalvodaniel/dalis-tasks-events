            "Foreign session reached an owned claim or ACK"
          )
          assert(
            canonical((await snapshot()).stores) === canonical(queued.stores) &&
              canonical(await state(owner)) === canonical(before),
            "Account change mutated owned local or remote data"
          )
          const foreign = await state(otherId)
          assert(
            foreign.page.through === 0 &&
              Object.values(foreign.counts).every((value) => value === 0),
            "Wrong actor received owned writes"
          )
          const restored = (await call(0, {
            type: "bootstrap",
            identity: "owner",
          })) as Reply
          assert(
            restored.status === 200 &&
              workspaceIdentitySchema.parse(restored.value).userId === owner,
            "Reauthentication changed original actor identity"
          )
          const recovered = (await call(0, { type: "mixed-run" })) as {
            status: string
            uploaded: number
          }
          assert(
            recovered.status === "settled" && recovered.uploaded === 2,
            "Same owner did not recover original pair"
          )
          const committed = await state(owner),
            complete = await snapshot()
          assert(
            committed.counts.receipts === before.counts.receipts + 2 &&
              committed.page.through === before.page.through + 2 &&
              canonical(await state(otherId)) === canonical(foreign),
            "Recovery duplicated history or changed foreign account"
          )
          for (const intent of original) {
            const acknowledged = complete.stores.outbox.find(
              (entry) =>
                entry.operation.operationId === intent.operation.operationId
            )
            assert(
              acknowledged?.state === "acknowledged" &&
                acknowledged.attempts === 1 &&
                acknowledged.lease === null &&
                canonical(acknowledged.operation) ===
                  canonical(intent.operation) &&
                canonical(acknowledged.dependencies) ===
                  canonical(intent.dependencies),
              "Recovery rewrote original account-switch intention"
            )
          }
          const stable = canonical(complete.stores)
          const idle = (await call(0, { type: "mixed-run" })) as {
            status: string
            uploaded: number
          }
          assert(
            idle.status === "settled" &&
              idle.uploaded === 0 &&
              canonical((await snapshot()).stores) === stable &&
              canonical(await state(owner)) === canonical(committed),
            "Recovered account created duplicate ACKs"
          )
        }
      )
      await check(
        "Revocar sesión bloquea RPC sin alterar datos confirmados",
        async () => {
          const before = await state(owner)
          const changed = (await call(1, {
            type: "session",
            command: "revoke",
          })) as Reply
          assert(changed.status === 200, "Owned session revocation failed")
          await push(1, batch(), "unauthorized")
          const pull = (await call(1, { type: "pull", userId: owner })) as Reply
          assert(pull.status === 401, "Revoked session downloaded data")
          assert(
            JSON.stringify(await state(owner)) === JSON.stringify(before),
            "Revocation changed committed data"
          )
        }
      )
      passed = true
    })()
      .catch((error) => {
        console.error(
          error instanceof Error
            ? error.message
            : "Recurring fixture assertion failed"
        )
        setStatus(
          "La prueba se ha bloqueado o ha fallado; revisa los escenarios completados"
        )
      })
      .finally(async () => {
        removeReady()
        clearTimeout(readyTimer)
        for (let index = 0; index < 2; index++) {
          try {
            assert(
              (await call(index, { type: "cleanup-local" })) === true,
              "Owned local cleanup failed"
            )
          } catch {
            passed = false
          }

          try {
            assert(
              (
                (await call(index, {
                  type: "session",
                  command: "cleanup",
                })) as Reply
              ).status === 200,
              "Owned session cleanup failed"
            )
          } catch {
            passed = false
          }
        }
        secondary?.close()
        if (passed)
          setStatus(
            "Dieciséis escenarios de frontera Next5 correctos; sesiones propias cerradas"
          )
        await fetch("/fixture/finish", {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          headers: {
            "Content-Type": "application/json",
            "x-sync-test-run": fixture.runId,
          },
          body: JSON.stringify({ runId: fixture.runId, passed }),
        })
      })
  }
  return (
    <main>
      <h1>Frontera recurrente Next5</h1>
      <p id="status" role="status">
        {status}
      </p>
      <button disabled={!config || running} onClick={run}>
        Ejecutar prueba RPC recurrente
      </button>
      <ol id="results">
        {rows.map((row) => (
          <li key={row}>{row}</li>
        ))}
      </ol>
    </main>
  )
}
