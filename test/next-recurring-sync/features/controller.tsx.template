"use client"

import { useEffect, useState } from "react"
import type { z } from "zod"
import {
  nextSyncPublicConfigSchema,
  nextSyncDeviceCommandSchema,
  nextRecurringSyncStateSchema,
} from "@/schemas/next-sync-test"
import { remoteRecurringPushResultSchema } from "@/schemas/remote-recurring-push"
import { encodeSyncProtocolRange } from "@/lib/sync/sync-protocol"
import { validateLocalRecurringBackup } from "@/lib/backup/local-backup"
import { localPullCursorSchema } from "@/schemas/local-sync"
import { syncOperationSchema } from "@/schemas/sync"
import { workspaceIdentitySchema } from "@/schemas/workspace"
import { executeFixtureCommand, fixtureFetch } from "@fixture/device-client"

function assert(value: unknown, message: string): asserts value {
  if (!value) throw new Error(message)
}
type Reply = { status: number; value: unknown; protocol: string | null }

export function FixtureController() {
  const [config, setConfig] = useState<z.infer<
    typeof nextSyncPublicConfigSchema
  > | null>(null)
  const [status, setStatus] = useState("Preparando la prueba aislada de Next")
  const [rows, setRows] = useState<string[]>([])
  const [running, setRunning] = useState(false)
  useEffect(() => {
    void (async () => {
      const run = new URLSearchParams(location.search).get("run")
      const parsed = nextSyncPublicConfigSchema.parse(
        await (
          await fetch(`/fixture/config?runId=${run}`, { cache: "no-store" })
        ).json()
      )
      assert(
        location.origin === parsed.origins[0],
        "Fixture controller host is invalid"
      )
      setConfig(parsed)
      setStatus("Listo. La prueba abre un segundo dispositivo en otra pestaña")
    })().catch(() => setStatus("No se ha podido preparar la prueba aislada"))
  }, [])

  const run = () => {
    if (!config || running) return
    const fixture = config
    setRunning(true)
    let secondary: Window | null = null
    let removeReady = () => {}
    let readyTimer: ReturnType<typeof setTimeout> | undefined
    const ready = new Promise<void>((resolveReady, reject) => {
      readyTimer = setTimeout(() => {
        removeReady()
        reject(new Error("Fixture second device did not become ready"))
      }, 45000)
      const listener = (event: MessageEvent) => {
        if (
          event.source !== secondary ||
          event.origin !== fixture.origins[1] ||
          event.data?.runId !== fixture.runId ||
          event.data?.ready !== true
        )
          return
        clearTimeout(readyTimer)
        removeReady()
        resolveReady()
      }
      window.addEventListener("message", listener)
      removeReady = () => window.removeEventListener("message", listener)
    })
    void ready.catch(() => {})
    // Open synchronously from the user gesture; both devices must be top-level first-party sites.
    secondary = window.open(
      `${fixture.origins[1]}/device?run=${fixture.runId}`,
      `dalis-next-sync-${fixture.runId}`
    )
    const call = async (
      index: number,
      command: z.infer<typeof nextSyncDeviceCommandSchema>
    ): Promise<unknown> => {
      const parsed = nextSyncDeviceCommandSchema.parse(command)
      if (index === 0) return executeFixtureCommand(fixture.runId, parsed)
      assert(
        secondary && !secondary.closed,
        "Fixture second device is unavailable"
      )
      const channel = new MessageChannel()
      try {
        return await new Promise((resolveReply, reject) => {
          const timer = setTimeout(
            () => reject(new Error("Fixture command timed out")),
            45000
          )
          channel.port1.onmessage = (event) => {
            clearTimeout(timer)
            if (event.data?.ok === true) resolveReply(event.data.value)
            else reject(new Error("Fixture second device command failed"))
          }
          secondary!.postMessage(
            { runId: fixture.runId, command: parsed },
            fixture.origins[1],
            [channel.port2]
          )
        })
      } finally {
        channel.port1.close()
      }
    }
    const check = async (label: string, work: () => Promise<void>) => {
      setStatus(label)
      await work()
      setRows((values) => [...values, `Correcto: ${label}`])
    }
    const state = async (userId: string) => {
      const response = await fixtureFetch(
        fixture.runId,
        `/fixture/state?runId=${fixture.runId}&userId=${encodeURIComponent(userId)}`
      )
      assert(response.status === 200, "Fixture state reader failed")
      return nextRecurringSyncStateSchema.parse(response.value)
    }
    const creation = syncOperationSchema.parse({
      operationId: crypto.randomUUID(),
      protocolVersion: 1,
      baseRevision: 0,
      command: {
        type: "item.create",
        itemId: crypto.randomUUID(),
        input: {
          kind: "plan",
          variant: "task",
          title: "Plan RPC recurrente aislado",
          description: "",
          status: "not_started",
          checklist: [],
          recurrence: {
            frequency: "daily",
            interval: 1,
            anchorDate: "2026-10-12",
            timeZone: "Europe/Madrid",
            end: { type: "never" },
          },
          schedule: {
            mode: "all_day",
            startDate: "2026-10-12",
            endDateExclusive: "2026-10-13",
          },
        },
      },
    })
    let owner = "",
      passed = false
    const push = async (
      index: number,
      input: unknown,
      status: string,
      retired = false
    ) => {
      const result = remoteRecurringPushResultSchema.parse(
        await call(index, { type: retired ? "retired-push" : "push", input })
      )
      assert(result.status === status, `Unexpected RPC status ${result.status}`)
      return result
    }
    void (async () => {
      assert(secondary, "Fixture popup was blocked")
      await ready
      await check("Acción5 real rechaza sesiones ausentes", async () => {
        for (let index = 0; index < 2; index++) {
          const identity = (await call(index, { type: "identity" })) as Reply
          assert(
            identity.status === 401,
            "Unauthenticated identity was exposed"
          )
          await push(
            index,
            {
              transportVersion: 2,
              expectedUserId: "fixture-unauthenticated",
              operations: [creation],
            },
            "unauthorized"
          )
        }
      })
      await check(
        "Dos sesiones persistidas anuncian exclusivamente5",
        async () => {
          for (let index = 0; index < 2; index++) {
            const boot = (await call(index, {
              type: "bootstrap",
              identity: "owner",
            })) as Reply
            assert(boot.status === 200, "Session bootstrap failed")
            const identity = (await call(index, { type: "identity" })) as Reply
            assert(
              identity.status === 200 &&
                identity.protocol === encodeSyncProtocolRange(5),
              "Identity protocol is not exclusive five"
            )
            const userId = workspaceIdentitySchema.parse(identity.value).userId
            if (!index) owner = userId
            else
              assert(
                userId === owner,
                "Persisted sessions do not share their actor"
              )
          }
          const initial = await state(owner)
          assert(
            initial.page.through === 0 &&
              Object.values(initial.counts).every((n) => n === 0),
            "Unauthenticated action wrote data"
          )
        }
      )
      const batch = () => ({
        transportVersion: 2,
        expectedUserId: owner,
        operations: [creation],
      })
      await check(
        "Handshake4 capturado conserva cola ante referencia ausente y retiro",
        async () => {
          const remoteBefore = await state(owner)
          for (let index = 0; index < 2; index++) {
            await call(index, { type: "prepare-local", userId: owner })
            const now = new Date().toISOString()
            const request = {
              mode: "create" as const,
              itemId: crypto.randomUUID(),
              contentOperationId: crypto.randomUUID(),
              viewOperationId: crypto.randomUUID(),
              primaryTagId: null,
              now,
              input: {
                kind: "plan" as const,
                variant: "note" as const,
                title: "Cola conservada ante retiro",
                description: "",
                status: "not_started" as const,
                checklist: [],
                recurrence: null,
                schedule: {
                  mode: "all_day" as const,
                  startDate: "2026-10-12",
                  endDateExclusive: "2026-10-13",
                },
              },
            }
            await call(index, { type: "save-plan", request })
            const snapshot = async () =>
              (await call(index, { type: "local-snapshot" })) as {
                backup: unknown
                cursor: unknown
              }
            for (const type of [
              "legacy-missing-action-run",
              "retired-mixed-action-run",
            ] as const) {
              const before = await snapshot()
              const baseline = validateLocalRecurringBackup(
                before.backup,
                owner
              )
              const root = baseline.stores.outbox.find(
                (entry) =>
                  entry.operation.operationId === request.contentOperationId
              )
              const dependent = baseline.stores.outbox.find(
                (entry) =>
                  entry.operation.operationId === request.viewOperationId
              )
              assert(
                root &&
                  dependent &&
                  root.state === "pending" &&
                  root.lease === null &&
                  dependent.dependencies.includes(root.operation.operationId),
                "Atomic producer lacks root and exact dependent"
              )
              const proof = (await call(index, { type })) as {
                handshake: string
                dispatches: number
                unrecognized: number
                identityReads: number
                pageReads: number
                probeStatus: number
                actionNotFound: string | null
                first: { status: string; uploaded: number; downloaded: number }
                second: { status: string; uploaded: number; downloaded: number }
                afterFirst: { backup: unknown; cursor: unknown }
                afterSecond: { backup: unknown; cursor: unknown }
              }
              assert(
                proof.handshake === "captured-prior-v4" &&
                  proof.dispatches === 1 &&
                  proof.identityReads === 1 &&
                  proof.pageReads === 1,
                "Captured old handshake was not bounded"
              )
              if (type === "legacy-missing-action-run")
                assert(
                  proof.probeStatus === 409 &&
                    proof.actionNotFound === "1" &&
                    proof.unrecognized === 1,
                  "Missing action was not rejected by compiled Next"
                )
              assert(
                proof.first.status ===
                  (type === "legacy-missing-action-run"
                    ? "retry_later"
                    : "update_required") &&
                  proof.first.uploaded === 0 &&
                  proof.first.downloaded === 0,
                "Old action acknowledged queued work"
              )
              assert(
                proof.second.status === "update_required" &&
                  proof.second.uploaded === 0 &&
                  proof.second.downloaded === 0,
                "New handshake did not block before another claim"
              )
              const expected = structuredClone(baseline.stores)
              const attempted = expected.outbox.find(
                (entry) =>
                  entry.operation.operationId === root.operation.operationId
              )
              assert(attempted, "Snapshot lacks attempted root")
              attempted.attempts++
              for (const retained of [
                proof.afterFirst,
                proof.afterSecond,
                await snapshot(),
              ]) {
                assert(
                  JSON.stringify(
                    validateLocalRecurringBackup(retained.backup, owner).stores
                  ) === JSON.stringify(expected) &&
                    JSON.stringify(
                      localPullCursorSchema.parse(retained.cursor)
                    ) ===
                      JSON.stringify(
                        localPullCursorSchema.parse(before.cursor)
                      ),
                  `Retirement changed stores ${JSON.stringify(Object.keys(expected).filter((key) => JSON.stringify(validateLocalRecurringBackup(retained.backup, owner).stores[key as keyof typeof expected]) !== JSON.stringify(expected[key as keyof typeof expected])))} or cursor`
                )
              }
            }
          }
          assert(
            JSON.stringify(await state(owner)) === JSON.stringify(remoteBefore),
            "Rejected old clients changed Mongo"
          )
        }
      )
      await check(
        "Matriz4↔5 rechaza antes del cuerpo; ID ausente devuelve409 marcado",
        async () => {
          for (let index = 0; index < 2; index++) {
            const proof = (await call(index, { type: "protocol-matrix" })) as {
              cases: number
              bodies: number
              missing: boolean
            }
            assert(
              proof.cases === 4 && proof.bodies === 0 && proof.missing,
              `Protocol or missing-reference proof failed: ${JSON.stringify(proof)}`
            )
          }
          assert(
            (await state(owner)).counts.receipts === 0,
            "Matrix produced a receipt"
          )
        }
      )
      await check(
        "Cuenta esperada se valida antes de ejecutar o descargar",
        async () => {
          for (let index = 0; index < 2; index++) {
            await push(
              index,
              { ...batch(), expectedUserId: "fixture-foreign" },
              "account_changed"
            )
            const pull = (await call(index, {
              type: "pull",
              userId: "fixture-foreign",
            })) as Reply
            assert(pull.status === 409, "Foreign actor pull was accepted")
          }
          assert(
            (await state(owner)).counts.receipts === 0,
            "Actor rejection produced a receipt"
          )
        }
      )
      await check(
        "Readiness5 bloquea; retiro preparatorio4 no ejecuta ni confirma",
        async () => {
          const blocked = await fixtureFetch(
            fixture.runId,
            "/fixture/readiness",
            { runId: fixture.runId, command: "block" }
          )
          assert(blocked.status === 200, "Readiness fault injection failed")
          try {
            await push(0, batch(), "retry_later")
            await push(0, batch(), "update_required", true)
            const pull = (await call(0, {
              type: "pull",
              userId: owner,
            })) as Reply
            assert(
              pull.status === 503 &&
                pull.protocol === encodeSyncProtocolRange(5),
              "Missing occurrence index did not block pull"
            )
            assert(
              (await state(owner)).counts.receipts === 0,
              "Readiness or retirement wrote a receipt"
            )
          } finally {
            const restored = await fixtureFetch(
              fixture.runId,
              "/fixture/readiness",
              { runId: fixture.runId, command: "restore" }
            )
            assert(
              restored.status === 200,
              "Owned readiness restoration failed"
            )
          }
        }
      )
      await check(
        "Defaults5 confirman una vez y replay conserva journal exacto",
        async () => {
          const result = await push(0, batch(), "complete")
          assert(
            result.status === "complete" &&
              result.results.length === 1 &&
              result.results[0].outcome.status === "applied",
            "Real action lacks applied outcome"
          )
          const committed = await state(owner)
          assert(
            committed.counts.items === 1 &&
              committed.counts.receipts === 1 &&
              committed.page.through === 1,
            "Atomic action did not commit one item and receipt"
          )
          const replay = await push(1, batch(), "complete")
          assert(
            JSON.stringify(replay) === JSON.stringify(result),
            "Replay outcome changed"
          )
          assert(
            JSON.stringify(await state(owner)) === JSON.stringify(committed),
            "Replay changed authoritative history"
          )
          for (let index = 0; index < 2; index++) {
            const pull = (await call(index, {
              type: "pull",
              userId: owner,
            })) as Reply
            assert(
              pull.status === 200 &&
                pull.protocol === encodeSyncProtocolRange(5) &&
                JSON.stringify(pull.value) === JSON.stringify(committed.page),
              "Authenticated download differs from Mongo"
            )
          }
        }
      )
      await check(
        "Aparición propia confirma una vez y se descarga en ambos clientes",
        async () => {
          assert(
            creation.command.type === "item.create",
            "Fixture series creation changed"
          )
          const appearance = syncOperationSchema.parse({
            operationId: crypto.randomUUID(),
            protocolVersion: 1,
            baseRevision: 1,
            command: {
              type: "plan.set-occurrence-status",
              itemId: creation.command.itemId,
              occurrenceId: `${creation.command.itemId}:2026-10-12`,
              expectedOccurrenceRevision: 0,
              status: "in_progress",
            },
          })
          const request = {
            transportVersion: 2,
            expectedUserId: owner,
            operations: [appearance],
          }
          const result = await push(1, request, "complete")
          assert(
            result.status === "complete" &&
              result.results[0].kind === "plan-occurrence" &&
              result.results[0].outcome.status === "applied",
            "Appearance did not execute its real dispatcher"
          )
          const committed = await state(owner)
          assert(
            committed.counts.occurrences === 1 &&
              committed.counts.receipts === 2 &&
              committed.page.through === 2 &&
              committed.page.changes[1].kind === "plan-occurrence",
            "Appearance journal or count is incomplete"
          )
          assert(
            JSON.stringify(await push(0, request, "complete")) ===
              JSON.stringify(result),
            "Appearance replay changed outcome"
          )
          assert(
            JSON.stringify(await state(owner)) === JSON.stringify(committed),
            "Appearance replay wrote duplicate history"
          )
          for (let index = 0; index < 2; index++) {
            const pull = (await call(index, {
              type: "pull",
              userId: owner,
            })) as Reply
            assert(
              pull.status === 200 &&
                JSON.stringify(pull.value) === JSON.stringify(committed.page),
              "Appearance download differs between authenticated clients"
            )
          }
        }
      )
      await check(
        "Revocar sesión bloquea RPC sin alterar datos confirmados",
        async () => {
          const before = await state(owner)
          const changed = (await call(1, {
            type: "session",
            command: "revoke",
          })) as Reply
          assert(changed.status === 200, "Owned session revocation failed")
          await push(1, batch(), "unauthorized")
          const pull = (await call(1, { type: "pull", userId: owner })) as Reply
          assert(pull.status === 401, "Revoked session downloaded data")
          assert(
            JSON.stringify(await state(owner)) === JSON.stringify(before),
            "Revocation changed committed data"
          )
        }
      )
      passed = true
    })()
      .catch((error) => {
        console.error(
          error instanceof Error
            ? error.message
            : "Recurring fixture assertion failed"
        )
        setStatus(
          "La prueba se ha bloqueado o ha fallado; revisa los escenarios completados"
        )
      })
      .finally(async () => {
        removeReady()
        clearTimeout(readyTimer)
        for (let index = 0; index < 2; index++) {
          try {
            assert(
              (await call(index, { type: "cleanup-local" })) === true,
              "Owned local cleanup failed"
            )
          } catch {
            passed = false
          }

          try {
            assert(
              (
                (await call(index, {
                  type: "session",
                  command: "cleanup",
                })) as Reply
              ).status === 200,
              "Owned session cleanup failed"
            )
          } catch {
            passed = false
          }
        }
        secondary?.close()
        if (passed)
          setStatus(
            "Nueve escenarios de frontera Next5 correctos; sesiones propias cerradas"
          )
        await fetch("/fixture/finish", {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          headers: {
            "Content-Type": "application/json",
            "x-sync-test-run": fixture.runId,
          },
          body: JSON.stringify({ runId: fixture.runId, passed }),
        })
      })
  }
  return (
    <main>
      <h1>Frontera recurrente Next5</h1>
      <p id="status" role="status">
        {status}
      </p>
      <button disabled={!config || running} onClick={run}>
        Ejecutar prueba RPC recurrente
      </button>
      <ol id="results">
        {rows.map((row) => (
          <li key={row}>{row}</li>
        ))}
      </ol>
    </main>
  )
}
