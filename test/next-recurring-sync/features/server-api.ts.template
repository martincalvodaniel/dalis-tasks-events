import "server-only"

import { getSyncIdentityResponse } from "@/features/sync/identity-response"
import { getWorkspaceIdentity } from "@/features/workspace/server-identity"
import { getAuthenticatedRecurringSyncChangesResponse } from "@/features/sync/authenticated-recurring-pull"

export async function getFixtureSyncIdentity() {
  return getSyncIdentityResponse(await getWorkspaceIdentity(), 5)
}
export function getFixtureSyncChanges(request: Request) {
  return getAuthenticatedRecurringSyncChangesResponse(request)
}
