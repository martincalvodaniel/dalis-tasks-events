"use client"

import { startTransition } from "react"
import type { z } from "zod"
import { nextSyncDeviceCommandSchema } from "@/schemas/next-sync-test"
import { pushFixtureOperations } from "@fixture/actions"

export async function fixtureFetch(
  runId: string,
  path: string,
  input?: unknown
) {
  const response = await fetch(path, {
    method: input === undefined ? "GET" : "POST",
    headers: {
      "x-sync-test-run": runId,
      ...(input === undefined ? {} : { "Content-Type": "application/json" }),
    },
    body: input === undefined ? undefined : JSON.stringify(input),
    credentials: "same-origin",
    cache: "no-store",
  })
  const value = await response.json()
  return {
    status: response.status,
    value,
    protocol: response.headers.get("x-dalis-sync-protocol"),
  }
}
export async function executeFixtureCommand(
  runId: string,
  input: z.infer<typeof nextSyncDeviceCommandSchema>
) {
  const command = nextSyncDeviceCommandSchema.parse(input)
  if (command.type === "session" && command.command === "cleanup")
    return fixtureFetch(runId, "/fixture/session", {
      runId,
      command: command.command,
    })
  const guarded = await fixtureFetch(runId, "/fixture/guard")
  if (guarded.status !== 200)
    throw new Error("Fixture blocked before touching foreign auth cookies")
  if (command.type === "bootstrap")
    return fixtureFetch(runId, "/fixture/bootstrap", {
      runId,
      identity: command.identity,
    })
  if (command.type === "session")
    return fixtureFetch(runId, "/fixture/session", {
      runId,
      command: command.command,
    })
  if (command.type === "identity")
    return fixtureFetch(runId, "/fixture/identity")
  if (command.type === "pull")
    return fixtureFetch(
      runId,
      `/fixture/changes?expectedUserId=${encodeURIComponent(command.userId)}&after=0&limit=100`
    )
  return new Promise<unknown>((resolve, reject) =>
    startTransition(async () => {
      try {
        resolve(await pushFixtureOperations({ runId, input: command.input }))
      } catch {
        reject(new Error("Compiled fixture action failed"))
      }
    })
  )
}
