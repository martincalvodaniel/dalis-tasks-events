"use server"

import { headers } from "next/headers"
import { rejectRetiredSyncPushV3 } from "@/features/sync/retired-sync-push-v3"
import { validateNextSyncFixtureHeaders } from "@/lib/db/next-sync-fixture"
import { nextSyncActionSchema } from "@/schemas/next-sync-test"

export async function rejectFixtureLegacyOperations(input: unknown) {
  const parsed = nextSyncActionSchema.parse(input)
  const requestHeaders = await headers()
  validateNextSyncFixtureHeaders(requestHeaders, { runId: parsed.runId })
  return rejectRetiredSyncPushV3(parsed.input, requestHeaders)
}
