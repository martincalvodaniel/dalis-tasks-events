"use client"

import { ActiveSyncProvider } from "@/features/sync/components/active-sync-provider"
import type { usePlacementSyncEngine } from "@/features/sync/hooks/use-placement-sync-engine"
import { FixtureHookReporter } from "@fixture/hook-reporter"

export type FixtureHookEngine = ReturnType<typeof usePlacementSyncEngine>
export function FixtureHookEngine({
  account,
  report,
}: {
  account: { userId: string; epoch: string }
  report(engine: FixtureHookEngine): void
}) {
  return (
    <ActiveSyncProvider account={{...account, itemCount: 0, offlineReady: false}}> 
      <FixtureHookReporter report={report} />
    </ActiveSyncProvider>
  )
}
