"use client"

import { SyncContext } from "@/features/sync/sync-context"
import { usePlacementSyncEngine } from "@/features/sync/hooks/use-placement-sync-engine"
import { FixtureHookReporter } from "@fixture/hook-reporter"

export type FixtureHookEngine = ReturnType<typeof usePlacementSyncEngine>
export function FixtureHookEngine({
  account,
  report,
}: {
  account: { userId: string; epoch: string }
  report(engine: FixtureHookEngine): void
}) {
  const engine = usePlacementSyncEngine(account)
  return (
    <SyncContext value={engine}>
      <FixtureHookReporter report={report} />
    </SyncContext>
  )
}
