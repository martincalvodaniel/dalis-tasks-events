"use client"
import { proveRemoteTagOrderRecovery } from "@fixture/tag-order-recovery"
import { proveRemoteItemViewRecovery } from "@fixture/item-view-recovery"
import { proveRemotePlanCategoryRecovery } from "@fixture/plan-category-recovery"
import { proveRemoteTagRecovery } from "@fixture/tag-recovery"
import { proveRemoteAppearanceRetry } from "@fixture/appearance-retry"
import { proveRemoteAppearanceRecovery } from "@fixture/appearance-recovery"
import { proveRemoteSettingsRecovery } from "@fixture/settings-recovery"
import { proveRemoteCommonPlanRecovery } from "@fixture/common-plan-recovery"
import type { RecurringSyncIncidentOverview } from "@/types/recurring-sync-incident"
import { useEffect, useState } from "react"
import type { z } from "zod"
import {
  nextSyncPublicConfigSchema,
  nextSettingsProofScopeSchema,
  nextSyncDeviceCommandSchema,
  nextSettingsSyncStateSchema,
} from "@/schemas/next-sync-test"
import { canonical, ordered, foldRecurringChanges } from "@fixture/projection"
import { remoteRecurringPushResultSchema } from "@/schemas/remote-recurring-push"
import { encodeSyncProtocolRange } from "@/lib/sync/sync-protocol"
import { validateLocalRecurringBackup } from "@/lib/backup/local-backup"
import { localPullCursorSchema } from "@/schemas/local-sync"
import { editablePlanOccurrence } from "@/lib/calendar/plan-occurrence-command"
import { planOccurrenceSchema } from "@/schemas/plan-occurrence"
import { planSchema } from "@/schemas/plan-item"
import { userSettingsSchema } from "@/schemas/preferences"
import { outboxEntrySchema } from "@/schemas/local-sync"
import { syncOperationSchema } from "@/schemas/sync"
import { workspaceIdentitySchema } from "@/schemas/workspace"
import { executeFixtureCommand, fixtureFetch } from "@fixture/device-client"

function assert(value: unknown, message: string): asserts value {
  if (!value) throw new Error(message)
}
type Reply = { status: number; value: unknown; protocol: string | null }

export function FixtureController() {
  const [config, setConfig] = useState<z.infer<
    typeof nextSyncPublicConfigSchema
  > | null>(null)
  const [status, setStatus] = useState("Preparando la prueba aislada de Next")
  const [rows, setRows] = useState<string[]>([])
  const [running, setRunning] = useState(false)
  const [proofScope, setProofScope] = useState<"full" | "joint-ui" | "assignment" | "assignment-series" | "tag-order">("full")
  useEffect(() => {
    void (async () => {
      const query = new URLSearchParams(location.search)
      const scope = nextSettingsProofScopeSchema.parse(query.get("scope") ?? undefined)
      const run = query.get("run")
      const parsed = nextSyncPublicConfigSchema.parse(
        await (
          await fetch(`/fixture/config?runId=${run}`, { cache: "no-store" })
        ).json()
      )
      assert(
        location.origin === parsed.origins[0],
        "Fixture controller host is invalid"
      )
      setProofScope(scope)
      setConfig(parsed)
      setStatus("Listo. La prueba abre un segundo dispositivo en otra pestaña")
    })().catch(() => setStatus("No se ha podido preparar la prueba aislada"))
  }, [])

  const run = () => {
    if (!config || running) return
    const fixture = config
    setRunning(true)
    let secondary: Window | null = null
    let removeReady = () => {}
    let readyTimer: ReturnType<typeof setTimeout> | undefined
    const ready = new Promise<void>((resolveReady, reject) => {
      readyTimer = setTimeout(() => {
        removeReady()
        reject(new Error("Fixture second device did not become ready"))
      }, 45000)
      const listener = (event: MessageEvent) => {
        if (
          event.source !== secondary ||
          event.origin !== fixture.origins[1] ||
          event.data?.runId !== fixture.runId ||
          event.data?.ready !== true
        )
          return
        clearTimeout(readyTimer)
        removeReady()
        resolveReady()
      }
      window.addEventListener("message", listener)
      removeReady = () => window.removeEventListener("message", listener)
    })
    void ready.catch(() => {})
    // Open synchronously from the user gesture; both devices must be top-level first-party sites.
    secondary = window.open(
      `${fixture.origins[1]}/device?run=${fixture.runId}`,
      `dalis-next-sync-${fixture.runId}`
    )
    const call = async (
      index: number,
      command: z.infer<typeof nextSyncDeviceCommandSchema>
    ): Promise<unknown> => {
      const parsed = nextSyncDeviceCommandSchema.parse(command)
      if (index === 0) return executeFixtureCommand(fixture.runId, parsed)
      assert(
        secondary && !secondary.closed,
        "Fixture second device is unavailable"
      )
      const channel = new MessageChannel()
      try {
        return await new Promise((resolveReply, reject) => {
          const timer = setTimeout(
            () => reject(new Error("Fixture command timed out")),
            parsed.type === "resolve-assignment-ui" ? 120000 : 45000
          )
          channel.port1.onmessage = (event) => {
            clearTimeout(timer)
            if (event.data?.ok === true) resolveReply(event.data.value)
            else reject(new Error("Fixture second device command failed"))
          }
          secondary!.postMessage(
            { runId: fixture.runId, command: parsed },
            fixture.origins[1],
            [channel.port2]
          )
        })
      } finally {
        channel.port1.close()
      }
    }
    const check = async (label: string, work: () => Promise<void>) => {
      setStatus(label)
      await work()
      setRows((values) => [...values, `Correcto: ${label}`])
    }
    const state = async (userId: string) => {
      const response = await fixtureFetch(
        fixture.runId,
        `/fixture/state?runId=${fixture.runId}&userId=${encodeURIComponent(userId)}`
      )
      assert(response.status === 200, "Fixture state reader failed")
      return nextSettingsSyncStateSchema.parse(response.value)
    }
    const creation = syncOperationSchema.parse({
      operationId: crypto.randomUUID(),
      protocolVersion: 1,
      baseRevision: 0,
      command: {
        type: "settings.update",
        input: { timeZone: "Europe/Madrid", weekStartsOn: 1, locale: "es-ES" },
      },
    })
    let owner = "",
      passed = false
    const batch = (operation = creation) => ({
      transportVersion: 2,
      expectedUserId: owner,
      operations: [operation],
    })
    const push = async (
      index: number,
      input: unknown,
      status: string,
      retired = false
    ) => {
      const result = remoteRecurringPushResultSchema.parse(
        await call(index, { type: retired ? "retired-push" : "push", input })
      )
      assert(
        result.status === status,
        `Unexpected settings RPC status ${result.status}`
      )
      return result
    }
    const snapshot = async (index: number) => {
      const value = (await call(index, { type: "local-snapshot" })) as {
        backup: unknown
        cursor: unknown
      }
      return {
        backup: validateLocalRecurringBackup(value.backup, owner),
        cursor: localPullCursorSchema.parse(value.cursor),
      }
    }
    void (async () => {
      assert(secondary, "Fixture popup was blocked")
      await ready
      await check(
        "Acción6 rechaza sesiones ausentes sin escribir",
        async () => {
          for (let index = 0; index < 2; index++) {
            assert(
              ((await call(index, { type: "identity" })) as Reply).status ===
                401,
              "Unauthenticated identity was exposed"
            )
            await push(
              index,
              { ...batch(), expectedUserId: "owned-unauthenticated" },
              "unauthorized"
            )
          }
        }
      )
      await check(
        "Dos sesiones persistidas anuncian exclusivamente6",
        async () => {
          for (let index = 0; index < 2; index++) {
            const boot = (await call(index, {
              type: "bootstrap",
              identity: "owner",
            })) as Reply
            assert(boot.status === 200, "Settings session bootstrap failed")
            const identity = (await call(index, { type: "identity" })) as Reply
            assert(
              identity.status === 200 &&
                identity.protocol === encodeSyncProtocolRange(6),
              "Settings identity did not announce exclusive six"
            )
            const actor = workspaceIdentitySchema.parse(identity.value).userId
            if (index === 0) owner = actor
            else
              assert(
                owner === actor,
                "Persisted settings sessions have different actors"
              )
          }
          const initial = await state(owner)
          assert(
            initial.page.through === 0 &&
              Object.values(initial.counts).every((n) => n === 0),
            "Unauthenticated settings action wrote data"
          )
        }
      )
      await check(
        "Matriz5↔6 bloquea antes del body e IDausente está verificado",
        async () => {
          for (let index = 0; index < 2; index++) {
            const proof = (await call(index, { type: "protocol-matrix" })) as {
              cases: number
              bodies: number
              missing: boolean
              missingStatus: number
              missingHeader: string | null
            }
            assert(
              proof.cases === 4 &&
                proof.bodies === 0 &&
                proof.missing &&
                proof.missingStatus === 409 &&
                proof.missingHeader === "1",
              "Settings matrix consumed a body or did not prove its absent action"
            )
          }
          assert(
            (await state(owner)).counts.receipts === 0,
            "Protocol mismatch wrote a receipt"
          )
        }
      )
      await check(
        "Actor esperado y sobre inválido no llegan al ejecutor",
        async () => {
          for (let index = 0; index < 2; index++) {
            await push(
              index,
              { ...batch(), expectedUserId: "owned-other" },
              "account_changed"
            )
            await push(
              index,
              { ...batch(), transportVersion: 1 },
              "update_required"
            )
            const pull = (await call(index, {
              type: "pull",
              userId: "owned-other",
            })) as Reply
            assert(
              pull.status === 409,
              "Foreign expected actor pull was accepted"
            )
          }
          assert(
            (await state(owner)).counts.receipts === 0,
            "Rejected settings actor wrote a receipt"
          )
        }
      )
      await check(
        "Readiness6 bloquea; acción5 capturada se retira sin ejecutar",
        async () => {
          const blocked = await fixtureFetch(
            fixture.runId,
            "/fixture/readiness",
            { runId: fixture.runId, command: "block" }
          )
          assert(
            blocked.status === 200,
            "Owned settings readiness injection failed"
          )
          try {
            await push(0, batch(), "retry_later")
            await push(1, batch(), "update_required", true)
            const pull = (await call(0, {
              type: "pull",
              userId: owner,
            })) as Reply
            assert(
              pull.status === 503 &&
                pull.protocol === encodeSyncProtocolRange(6),
              "Missing settings index did not block pull"
            )
            assert(
              (await state(owner)).counts.receipts === 0,
              "Readiness or captured action5 acknowledged a settings operation"
            )
          } finally {
            assert(
              (
                await fixtureFetch(fixture.runId, "/fixture/readiness", {
                  runId: fixture.runId,
                  command: "restore",
                })
              ).status === 200,
              "Owned settings index restoration failed"
            )
          }
        }
      )
      await check(
        "Defaults reales6 confirman una vez y replay no duplica historia",
        async () => {
          const result = await push(0, batch(), "complete")
          assert(
            result.status === "complete" &&
              result.results.length === 1 &&
              result.results[0].outcome.status === "applied",
            "Settings action did not apply"
          )
          const committed = await state(owner)
          assert(
            committed.counts.settings === 1 &&
              committed.counts.receipts === 1 &&
              committed.page.through === 1,
            "Settings commit lacks its exact record, receipt or journal"
          )
          await push(1, batch(), "complete")
          assert(
            canonical(await state(owner)) === canonical(committed),
            "Settings replay changed committed state"
          )
        }
      )
      await check(
        "CAS obsoleto conserva conflicto explícito sin cambiar la zona",
        async () => {
          const stale = syncOperationSchema.parse({
            ...creation,
            operationId: crypto.randomUUID(),
          })
          const result = await push(1, batch(stale), "complete")
          assert(
            result.status === "complete" &&
              result.results[0].outcome.status === "conflict",
            "Stale settings CAS was acknowledged as applied"
          )
          const current = await state(owner)
          assert(
            current.counts.settings === 1 &&
              current.counts.receipts === 2 &&
              current.page.through === 1,
            "Stale CAS mutated settings or appended applied history"
          )
        }
      )
      await check(
        "Nueva revisión y descarga conservan replay antiguo sin regresión",
        async () => {
          const next = syncOperationSchema.parse({
            ...creation,
            operationId: crypto.randomUUID(),
            baseRevision: 1,
            command: {
              type: "settings.update",
              input: {
                timeZone: "Pacific/Kiritimati",
                weekStartsOn: 1,
                locale: "es-ES",
              },
            },
          })
          const result = await push(0, batch(next), "complete")
          assert(
            result.status === "complete" &&
              result.results[0].outcome.status === "applied",
            "Next settings revision was not applied"
          )
          const committed = await state(owner)
          assert(
            committed.counts.settings === 1 &&
              committed.counts.receipts === 3 &&
              committed.page.through === 2,
            "Next settings revision has inconsistent history"
          )
          await push(1, batch(), "complete")
          assert(
            canonical(await state(owner)) === canonical(committed),
            "Late original replay replaced newer settings"
          )
          for (let index = 0; index < 2; index++) {
            const reply = (await call(index, {
              type: "pull",
              userId: owner,
            })) as Reply
            assert(
              reply.status === 200 &&
                reply.protocol === encodeSyncProtocolRange(6) &&
                canonical(reply.value) === canonical(committed.page),
              "Settings pull did not return the exact authenticated journal"
            )
          }
        }
      )
      const planRequest = {
        mode: "create" as const,
        itemId: crypto.randomUUID(),
        contentOperationId: crypto.randomUUID(),
        viewOperationId: crypto.randomUUID(),
        primaryTagId: null,
        now: new Date().toISOString(),
        input: {
          kind: "plan" as const,
          variant: "note" as const,
          title: "Serie para comprobar zona personal",
          description: "",
          status: "not_started" as const,
          checklist: [],
          recurrence: {
            frequency: "daily" as const,
            interval: 1,
            anchorDate: "2026-10-17",
            timeZone: "Europe/Madrid",
            end: { type: "count" as const, count: 3 },
          },
          schedule: {
            mode: "all_day" as const,
            startDate: "2026-10-17",
            endDateExclusive: "2026-10-18",
          },
        },
      }
      await check(
        "Handshake5 capturado conserva cola ante referencia ausente y retiro",
        async () => {
          const remoteBefore = await state(owner)
          for (let index = 0; index < 2; index++) {
            await call(index, { type: "prepare-legacy-local", userId: owner })
            const now = new Date().toISOString()
            const request = {
              mode: "create" as const,
              itemId: crypto.randomUUID(),
              contentOperationId: crypto.randomUUID(),
              viewOperationId: crypto.randomUUID(),
              primaryTagId: null,
              now,
              input: {
                kind: "plan" as const,
                variant: "note" as const,
                title: "Cola conservada ante retiro",
                description: "",
                status: "not_started" as const,
                checklist: [],
                recurrence: null,
                schedule: {
                  mode: "all_day" as const,
                  startDate: "2026-10-12",
                  endDateExclusive: "2026-10-13",
                },
              },
            }
            await call(index, { type: "save-plan", request })
            const snapshot = async () =>
              (await call(index, { type: "local-snapshot" })) as {
                backup: unknown
                cursor: unknown
              }
            for (const type of [
              "legacy-missing-action-run",
              "retired-mixed-action-run",
            ] as const) {
              const before = await snapshot()
              const baseline = validateLocalRecurringBackup(
                before.backup,
                owner
              )
              const root = baseline.stores.outbox.find(
                (entry) =>
                  entry.operation.operationId === request.contentOperationId
              )
              const dependent = baseline.stores.outbox.find(
                (entry) =>
                  entry.operation.operationId === request.viewOperationId
              )
              assert(
                root &&
                  dependent &&
                  root.state === "pending" &&
                  root.lease === null &&
                  dependent.dependencies.includes(root.operation.operationId),
                "Atomic producer lacks root and exact dependent"
              )
              const proof = (await call(index, { type })) as {
                handshake: string
                dispatches: number
                unrecognized: number
                identityReads: number
                pageReads: number
                probeStatus: number
                actionNotFound: string | null
                first: { status: string; uploaded: number; downloaded: number }
                second: { status: string; uploaded: number; downloaded: number }
                afterFirst: { backup: unknown; cursor: unknown }
                afterSecond: { backup: unknown; cursor: unknown }
              }
              assert(
                proof.handshake === "captured-prior-v5" &&
                  proof.dispatches === 1 &&
                  proof.identityReads === 1 &&
                  proof.pageReads === 1,
                "Captured old handshake was not bounded"
              )
              if (type === "legacy-missing-action-run")
                assert(
                  proof.probeStatus === 409 &&
                    proof.actionNotFound === "1" &&
                    proof.unrecognized === 1,
                  "Missing action was not rejected by compiled Next"
                )
              assert(
                proof.first.status ===
                  (type === "legacy-missing-action-run"
                    ? "retry_later"
                    : "update_required") &&
                  proof.first.uploaded === 0 &&
                  proof.first.downloaded === 0,
                "Old action acknowledged queued work"
              )
              assert(
                proof.second.status === "update_required" &&
                  proof.second.uploaded === 0 &&
                  proof.second.downloaded === 0,
                "New handshake did not block before another claim"
              )
              const expected = structuredClone(baseline.stores)
              const attempted = expected.outbox.find(
                (entry) =>
                  entry.operation.operationId === root.operation.operationId
              )
              assert(attempted, "Snapshot lacks attempted root")
              attempted.attempts++
              for (const retained of [
                proof.afterFirst,
                proof.afterSecond,
                await snapshot(),
              ]) {
                assert(
                  JSON.stringify(
                    validateLocalRecurringBackup(retained.backup, owner).stores
                  ) === JSON.stringify(expected) &&
                    JSON.stringify(
                      localPullCursorSchema.parse(retained.cursor)
                    ) ===
                      JSON.stringify(
                        localPullCursorSchema.parse(before.cursor)
                      ),
                  `Retirement changed stores ${JSON.stringify(Object.keys(expected).filter((key) => JSON.stringify(validateLocalRecurringBackup(retained.backup, owner).stores[key as keyof typeof expected]) !== JSON.stringify(expected[key as keyof typeof expected])))} or cursor`
                )
              }
            }
          }
          assert(
            JSON.stringify(await state(owner)) === JSON.stringify(remoteBefore),
            "Rejected old clients changed Mongo"
          )
        }
      )
      await check(
        "Cliente6 prepara dos particiones y descarga la zona existente",
        async () => {
          for (let index = 0; index < 2; index++) {
            const result = (await call(index, { type: "mixed-run" })) as {
              status: string
              uploaded: number
              downloaded: number
            }
            assert(
              result.status === "settled" &&
                result.uploaded === 2 &&
                result.downloaded >= 4,
              "Settings client failed its initial exact pull"
            )
            const current = userSettingsSchema.parse(
              await call(index, { type: "read-settings" })
            )
            assert(
              current.timeZone === "Pacific/Kiritimati" &&
                current.revision === 2,
              "Initial settings pull is not the latest revision"
            )
          }
          await call(0, { type: "mixed-run" })
          await call(0, { type: "save-plan", request: planRequest })
          const result = (await call(0, { type: "mixed-run" })) as {
            status: string
            uploaded: number
          }
          assert(
            result.status === "settled" && result.uploaded === 2,
            "Real series producer failed its atomic root and view ACK"
          )
          await call(1, { type: "mixed-run" })
        }
      )
      if(proofScope === "full" || proofScope === "tag-order") await check("Orden de categorías recupera multiefectos, tombstones y ACK único tras recarga",async()=>{
        const proof=await proveRemoteTagOrderRecovery({owner,call,snapshot,state:()=>state(owner),reloadSecondary:async()=>{
          const reloaded=new Promise<void>((resolve,reject)=>{
            const listener=(event:MessageEvent)=>{if(event.source!==secondary||event.origin!==fixture.origins[1]||event.data?.runId!==fixture.runId||event.data?.ready!==true)return;clearTimeout(timer);window.removeEventListener("message",listener);resolve()}
            const timer=setTimeout(()=>{window.removeEventListener("message",listener);reject(new Error("Owned order reload timed out"))},45000);window.addEventListener("message",listener)
          })
          await call(1,{type:"reload-local"});await reloaded
        }})
        assert(proof.adopted===2 && proof.retried===2 && proof.lostReplies===2,"Order proof incomplete")
      })
      if(proofScope === "tag-order"){passed=true;return}
      if(proofScope !== "assignment" && proofScope !== "assignment-series") await check("Contenido y categoría recuperados juntos con dos CAS y ACK únicos tras recarga", async () => {
        const proof = await proveRemotePlanCategoryRecovery({ owner, call, snapshot, state: () => state(owner), reloadSecondary: async () => {
          const reloaded = new Promise<void>((resolve, reject) => {
            const listener = (event: MessageEvent) => {
              if (event.source !== secondary || event.origin !== fixture.origins[1] || event.data?.runId !== fixture.runId || event.data?.ready !== true) return
              clearTimeout(timer); window.removeEventListener("message", listener); resolve()
            }
            const timer = setTimeout(() => { window.removeEventListener("message", listener); reject(new Error("Owned joint reload timed out")) }, 45000)
            window.addEventListener("message", listener)
          })
          await call(1, { type: "reload-local" }); await reloaded
        } })
        assert(proof.adopted === 1 && proof.retried === 3 && proof.lostReplies === 2, "Joint remote evidence incomplete")
      })
      if (proofScope === "joint-ui") { passed = true; return }
      await check("Asignaciones aisladas recuperan conflicto y ACK único tras recarga",async()=>{
        const proof=await proveRemoteItemViewRecovery({owner,call,snapshot,interactive:proofScope!=="assignment-series",state:()=>state(owner),reloadSecondary:async()=>{
          const reloaded=new Promise<void>((resolve,reject)=>{
            const listener=(event:MessageEvent)=>{if(event.source!==secondary||event.origin!==fixture.origins[1]||event.data?.runId!==fixture.runId||event.data?.ready!==true)return;clearTimeout(timer);window.removeEventListener("message",listener);resolve()}
            const timer=setTimeout(()=>{window.removeEventListener("message",listener);reject(new Error("Owned assignment reload timed out"))},45000);window.addEventListener("message",listener)
          })
          await call(1,{type:"reload-local"});await reloaded
        }})
        assert(proof.adopted===1 && proof.retried===3 && proof.lostReplies===2,"Assignment proof incomplete")
      })
      if(proofScope === "assignment" || proofScope === "assignment-series"){passed=true;return}
      await check(
        "Cuatro variantes recuperan conflictos reales y convergen sin ACK local",
        async () => {
          const proof = await proveRemoteCommonPlanRecovery({
            call,
            snapshot,
            state: () => state(owner),
            owner,
          })
          assert(
            proof.variants === 4 && proof.replayed === 1,
            "Remote common recovery proof is incomplete"
          )
        }
      )
      const offlineBefore = await state(owner)
      let firstSettingsId = "",
        secondSettingsId = "",
        occurrenceId = ""
      const originalEntries = new Map<
        string,
        { command: unknown; dependencies: string[] }
      >()
      await check(
        "Productores offline conservan UUID y dependencias de zona y aparición",
        async () => {
          const parent = planSchema.parse(
            (await snapshot(0)).backup.stores.items.find(
              (item) => item.id === planRequest.itemId
            )
          )
          const occurrenceCommand = {
            type: "plan.set-occurrence-status" as const,
            itemId: parent.id,
            occurrenceId: `${parent.id}:2026-10-18`,
            status: "completed" as const,
          }
          occurrenceId = occurrenceCommand.occurrenceId
          await call(0, {
            type: "commit-occurrence",
            command: occurrenceCommand,
            operationId: crypto.randomUUID(),
            now: new Date().toISOString(),
            expectedItem: parent,
            expectedOccurrence: editablePlanOccurrence(
              parent,
              null,
              occurrenceCommand,
              owner
            ).current,
          })
          const input = (timeZone: string) => ({
            timeZone,
            weekStartsOn: 1 as const,
            locale: "es-ES" as const,
          })
          const expected = userSettingsSchema.parse(
            await call(0, { type: "read-settings" })
          )
          const first = outboxEntrySchema.parse(
            await call(0, {
              type: "save-settings",
              input: input("America/New_York"),
              expected,
            })
          )
          firstSettingsId = first.operation.operationId
          const second = outboxEntrySchema.parse(
            await call(0, {
