"use client"
import type { z } from "zod"
import { canonical,ordered,foldRecurringChanges } from "@fixture/projection"
import { compareRank } from "@/lib/ordering/rank"
import { availableTagOrderResolutionChoices } from "@/lib/sync/tag-order-decision"
import { nextSyncDeviceCommandSchema,nextSettingsSyncStateSchema } from "@/schemas/next-sync-test"
import { tagOrderResolutionSnapshotSchema,tagOrderResolutionRecordSchema } from "@/schemas/tag-order-resolution"
import { outboxEntrySchema } from "@/schemas/local-sync"
import type { LocalRecurringBackup } from "@/types/local-backup"
import type { LocalPullCursor } from "@/types/local-sync"
import type { TagOrderResolutionRequest } from "@/types/tag-order-resolution"
type Snapshot={backup:LocalRecurringBackup;cursor:LocalPullCursor}
type Ports={interactive?:boolean;owner:string;call(index:number,command:z.infer<typeof nextSyncDeviceCommandSchema>):Promise<unknown>;snapshot(index:number):Promise<Snapshot>;state():Promise<z.infer<typeof nextSettingsSyncStateSchema>>;reloadSecondary():Promise<void>}
function assert(value:unknown,message:string):asserts value{if(!value)throw new Error(message)}
export async function proveRemoteTagOrderRecovery({owner,call,snapshot,state,reloadSecondary,interactive=false}:Ports){
 let adopted=0,retried=0,lostReplies=0
 for(const mode of ["adopt","retry","rerank","deleted-neighbor"] as const){
  const ids=[crypto.randomUUID(),crypto.randomUUID(),crypto.randomUUID()], initial=(await snapshot(0)).backup.stores.tags,base=Math.max(0,...initial.map(tag=>tag.position))+4096
  for(const [index,id] of ids.entries())await call(0,{type:"commit-local",command:{type:"tag.save",tagId:id,input:{name:`Order ${id}`,color:"#123456",position:mode==="rerank" && index>0?base+1024:base+index*1024}}})
  await call(0,{type:"mixed-run"})
  if(mode==="rerank"){
   const peer=(await snapshot(0)).backup.stores.tags.find(tag=>tag.id===ids[1]);assert(peer,"Rerank peer missing")
   await call(0,{type:"commit-local",command:{type:"tag.save",tagId:peer.id,input:{name:`Peer ${peer.id}`,color:"#654321",position:peer.position}}});await call(0,{type:"mixed-run"})
  }
  await call(1,{type:"mixed-run"})
  const peers=(await snapshot(0)).backup.stores.tags.filter(tag=>ids.slice(1).includes(tag.id)).toSorted(compareRank),end=peers[1].id
  await call(0,{type:"commit-local",command:{type:"tag.move",tagId:ids[0],beforeId:null,afterId:end}});await call(0,{type:"mixed-run"})
  const original=outboxEntrySchema.parse(await call(1,{type:"commit-local",command:{type:"tag.move",tagId:ids[0],beforeId:null,afterId:end}}))
  const latest=outboxEntrySchema.parse(await call(1,{type:"commit-local",command:{type:"tag.move",tagId:ids[0],beforeId:peers[1].id,afterId:peers[0].id}}))
  await call(1,{type:"mixed-run"})
  if(mode==="deleted-neighbor"){
   await call(0,{type:"commit-local",command:{type:"tag.delete",tagId:peers[1].id}});await call(0,{type:"mixed-run"});await call(1,{type:"mixed-run"})
  }
  const expected=tagOrderResolutionSnapshotSchema.parse(await call(1,{type:"tag-order-comparison",operationId:original.operation.operationId})),choice=mode==="adopt"||mode==="deleted-neighbor"?"adopt_remote":"retry_latest_move"
  assert(expected.incident.entry.state==="conflict"&&expected.incident.entry.attempts===1&&expected.incident.intentions.length===2,"Real order producer lost exact conflict chain")
  assert(canonical(expected.incident.intentions[1])===canonical(latest),"Reviewed latest move changed UUID/payload/dependencies")
  if(mode==="deleted-neighbor")assert(canonical(availableTagOrderResolutionChoices(expected,owner))===canonical(["adopt_remote"]),"Deleted neighbor still allowed a stale move")
  let request:TagOrderResolutionRequest={userId:owner,resolutionId:crypto.randomUUID(),operationId:choice==="retry_latest_move"?crypto.randomUUID():null,choice,createdAt:new Date().toISOString(),expected}
  const guard=await call(1,{type:"tag-order-guard-proof",request}) as {checks:number};assert(guard.checks===3,"Order guards incomplete")
  const before=await state(),localBefore=await snapshot(1),result=await call(1,{type:interactive&&(mode==="adopt"||mode==="retry")?"resolve-tag-order-ui":"resolve-tag-order",request}) as {status:string;record:unknown},record=tagOrderResolutionRecordSchema.parse(result.record)
  request={userId:record.userId,resolutionId:record.resolutionId,operationId:record.operationId,choice:record.choice,createdAt:record.createdAt,expected:record.expected}
  assert(result.status==="applied"&&canonical(await state())===canonical(before),"Local order choice manufactured remote history")
  const decided=await snapshot(1)
  for(const store of ["items","itemViews","taskPlacements","occurrences","settings","remoteShadows"] as const)assert(canonical(localBefore.backup.stores[store])===canonical(decided.backup.stores[store]),"Order recovery changed another domain")
  for(const old of expected.incident.intentions)assert(canonical(decided.backup.stores.outbox.find(e=>e.operation.operationId===old.operation.operationId))===canonical({...old,state:"superseded",lease:null}),"Order rewrote an original intention")
  for(const old of localBefore.backup.stores.syncMetadata.filter(v=>"result"in v))assert(decided.backup.stores.syncMetadata.some(v=>canonical(v)===canonical(old)),"Order lost outcome evidence")
  if(record.replacement){
   retried++
   const pending=decided.backup.stores.outbox.find(e=>e.operation.operationId===record.operationId)
   assert(pending?.state==="pending"&&pending.attempts===0&&!pending.dependencies.length&&canonical(record.replacement.command)===canonical(latest.operation.command)&&record.replacement.baseRevision===2,"Order retry changed last move or fresh CAS")
   if(mode==="rerank")assert(record.tags.filter(tag=>tag.position!==expected.observedTags.find(remote=>remote.id===tag.id)?.position).length>1,"Rerank did not include multiple peer effects")
   for(const tag of record.tags)assert(tag.revision===expected.observedTags.find(remote=>remote.id===tag.id)?.revision,"Optimistic order invented ACK revisions")
   const lost=await call(1,{type:"lost-plan-response-run"}) as {status:string;uploaded:number},committed=await state(),attempted=(await snapshot(1)).backup.stores.outbox.find(e=>e.operation.operationId===record.operationId)
   assert(lost.status==="retry_later"&&lost.uploaded===0&&attempted?.state==="pending"&&attempted.attempts===1&&!attempted.lease,"Lost order response manufactured ACK")
   assert(committed.counts.receipts===before.counts.receipts+1&&committed.page.through===before.page.through+1,"Order did not commit exactly once")
   await reloadSecondary();assert(canonical((await snapshot(1)).backup.stores.outbox.find(e=>e.operation.operationId===record.operationId))===canonical(attempted),"Order reload changed uncertain intention")
   await call(1,{type:"mixed-run"});assert(canonical(await state())===canonical(committed),"Order replay duplicated remote history")
   const ack=(await snapshot(1)).backup.stores.outbox.find(e=>e.operation.operationId===record.operationId)
   assert(ack?.state==="acknowledged"&&ack.attempts===2&&canonical(ack.operation)===canonical(record.replacement),"Order same UUID missed real replay ACK")
   lostReplies++
  }else adopted++
  await call(0,{type:"mixed-run"});await call(1,{type:"mixed-run"})
  const authoritative=await state(),projection=foldRecurringChanges(authoritative.page)
  assert(authoritative.counts.receipts===before.counts.receipts+Number(Boolean(record.replacement))&&authoritative.page.through===before.page.through+Number(Boolean(record.replacement)),"Order choice confirmed wrong history count")
  for(const index of [0,1]){
   const local=await snapshot(index),tags=local.backup.stores.tags
   assert(ordered(tags)===ordered([...projection.tags.values()]),"Full observed category catalog differs from Mongo")
   for(const tag of tags){const shadow=local.backup.stores.remoteShadows.find(v=>v.entityKey===`tag:${tag.id}`);assert(shadow&&"kind"in shadow&&shadow.kind==="preference"&&shadow.record.store==="tags"&&canonical(shadow.record.record)===canonical(tag),"Order shadow differs from Mongo")}
   assert(local.cursor.after===authoritative.page.through&&local.cursor.through===null,"Order cursor did not finish")
  }
  const later=await snapshot(1),replayed=await call(1,{type:"resolve-tag-order",request}) as {status:string}
  assert(replayed.status==="replayed"&&canonical((await snapshot(1)).backup.stores)===canonical(later.backup.stores),"Order replay overwrote later confirmed state")
 }
 return {adopted,retried,lostReplies}
}
