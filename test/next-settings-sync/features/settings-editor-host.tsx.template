"use client"

import { createRoot } from "react-dom/client"
import { SWRConfig } from "swr"
import { PersonalTimeZoneSettings } from "@/features/workspace/components/personal-time-zone-settings"
import { readLocalPersonalSettings } from "@/features/workspace/local-personal-settings"

export async function proveSettingsEditor(account: {
  userId: string
  epoch: string
}, interactive = true) {
  const container = document.createElement("aside")
  container.setAttribute("aria-label", "Ajustes de prueba")
  document.body.append(container)
  const root = createRoot(container)
  const originalFetch = globalThis.fetch
  let networkCalls = 0
  globalThis.fetch = async () => {
    networkCalls++
    throw new Error("Offline settings editor attempted a network request")
  }
  try {
    root.render(
      <SWRConfig value={{ provider: () => new Map() }}>
        <PersonalTimeZoneSettings account={account} />
      </SWRConfig>
    )
    await new Promise<void>((resolve, reject) => {
      let automatedStep: "open" | "save" | "done" = "open"
      const advance = () => {
        if (container.textContent?.includes("Guardado en este dispositivo")) {
          clearTimeout(timer)
          observer.disconnect()
          resolve()
          return
        }
        if (interactive) return
        if (automatedStep === "open") {
          const edit = [...container.querySelectorAll("button")].find(
            (button) => button.textContent?.trim() === "Editar zona" && !button.disabled
          )
          if (edit) {
            automatedStep = "save"
            edit.click()
          }
          return
        }
        if (automatedStep === "save") {
          const input = container.querySelector<HTMLInputElement>('input[name="timeZone"]')
          const save = container.querySelector<HTMLButtonElement>('button[type="submit"]')
          if (input && save && !input.disabled && !save.disabled) {
            automatedStep = "done"
            input.value = "America/Los_Angeles"
            input.dispatchEvent(new Event("input", { bubbles: true }))
            input.dispatchEvent(new Event("change", { bubbles: true }))
            save.click()
          }
        }
      }
      const observer = new MutationObserver(advance)
      const timer = setTimeout(() => {
        observer.disconnect()
        reject(new Error("Settings editor interaction timed out"))
      }, 90000)
      observer.observe(container, {
        subtree: true,
        childList: true,
        characterData: true,
        attributes: true,
        attributeFilter: ["disabled"],
      })
      advance()
    })
    if (networkCalls !== 0)
      throw new Error("Offline editor made a network request")
    return { settings: await readLocalPersonalSettings(account), networkCalls, interactive }
  } finally {
    globalThis.fetch = originalFetch
    root.unmount()
    container.remove()
  }
}
