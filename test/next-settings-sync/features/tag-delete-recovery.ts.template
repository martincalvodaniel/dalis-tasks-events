"use client"
import type { z } from "zod"
import { canonical,ordered,foldRecurringChanges } from "@fixture/projection"
import { availableTagDeletionResolutionChoices } from "@/lib/sync/tag-delete-decision"
import { nextSyncDeviceCommandSchema,nextSettingsSyncStateSchema } from "@/schemas/next-sync-test"
import { tagDeletionResolutionRecordSchema } from "@/schemas/tag-delete-resolution"
import { tagCatalogResolutionSnapshotSchema as tagDeletionResolutionSnapshotSchema } from "@/schemas/tag-catalog-resolution"
import { outboxEntrySchema } from "@/schemas/local-sync"
import type { LocalRecurringBackup } from "@/types/local-backup"
import type { LocalPullCursor } from "@/types/local-sync"
import type { TagDeletionResolutionRequest } from "@/types/tag-delete-resolution"
type Snapshot={backup:LocalRecurringBackup;cursor:LocalPullCursor}
type Ports={owner:string;call(index:number,command:z.infer<typeof nextSyncDeviceCommandSchema>):Promise<unknown>;snapshot(index:number):Promise<Snapshot>;state():Promise<z.infer<typeof nextSettingsSyncStateSchema>>;reloadSecondary():Promise<void>}
function assert(value:unknown,message:string):asserts value{if(!value)throw new Error(message)}
export async function proveRemoteTagDeletionRecovery({owner,call,snapshot,state,reloadSecondary}:Ports){
 let adopted=0,retried=0,lostReplies=0
 for(const mode of ["adopt","retry","tombstone"] as const){
  const id=crypto.randomUUID(),itemId=crypto.randomUUID(),now=new Date().toISOString()
  await call(0,{type:"commit-local",command:{type:"tag.save",tagId:id,input:{name:`Delete ${id}`,color:"#123456",position:1024}}})
  await call(0,{type:"mixed-run"})
  const input={kind:"plan" as const,variant:"note" as const,title:`Preserved ${id}`,description:"Preserved content",schedule:{mode:"all_day" as const,startDate:"2026-10-19",endDateExclusive:"2026-10-20"},status:"in_progress" as const,checklist:[{id:crypto.randomUUID(),text:"Preserved step",completed:true}],recurrence:null}
  await call(0,{type:"save-plan",request:{mode:"create",itemId,input,primaryTagId:id,contentOperationId:crypto.randomUUID(),viewOperationId:crypto.randomUUID(),now}})
  await call(0,{type:"mixed-run"});await call(1,{type:"mixed-run"})
  await call(0,{type:"commit-local",command:{type:"tag.save",tagId:id,input:{name:`Remote ${id}`,color:"#654321",position:2048}}});await call(0,{type:"mixed-run"})
  const original=outboxEntrySchema.parse(await call(1,{type:"commit-local",command:{type:"tag.delete",tagId:id}}))
  await call(1,{type:"mixed-run"})
  if(mode==="tombstone"){
   await call(0,{type:"commit-local",command:{type:"tag.delete",tagId:id}});await call(0,{type:"mixed-run"});await call(1,{type:"mixed-run"})
  }
  const expected=tagDeletionResolutionSnapshotSchema.parse(await call(1,{type:"tag-delete-comparison",operationId:original.operation.operationId})),choice=mode==="retry"?"retry_delete":"adopt_remote"
  assert(expected.incident.entry.state==="conflict"&&expected.incident.entry.attempts===1&&expected.incident.intentions.length===1,"Real deletion producer lost its exact conflict")
  assert(canonical(expected.incident.entry.operation)===canonical(original.operation)&&canonical(expected.incident.entry.dependencies)===canonical(original.dependencies),"Deletion changed original UUID, payload or dependencies")
  if(mode==="tombstone")assert(canonical(availableTagDeletionResolutionChoices(expected,owner))===canonical(["adopt_remote"]),"Remote tombstone still permits redundant deletion")
  const request:TagDeletionResolutionRequest={userId:owner,resolutionId:crypto.randomUUID(),operationId:choice==="retry_delete"?crypto.randomUUID():null,choice,createdAt:new Date().toISOString(),expected}
  const guard=await call(1,{type:"tag-delete-guard-proof",request}) as {checks:number};assert(guard.checks===3,"Deletion guards incomplete")
  const before=await state(),localBefore=await snapshot(1),result=await call(1,{type:"resolve-tag-delete",request}) as {status:string;record:unknown},record=tagDeletionResolutionRecordSchema.parse(result.record)
  assert(result.status==="applied"&&canonical(await state())===canonical(before),"Local deletion decision manufactured remote history")
  const decided=await snapshot(1)
  for(const store of ["items","itemViews","taskPlacements","occurrences","settings","remoteShadows"] as const)assert(canonical(localBefore.backup.stores[store])===canonical(decided.backup.stores[store]),"Deletion recovery changed another domain or assignment")
  assert(decided.backup.stores.itemViews.some(view=>view.itemId===itemId&&view.primaryTagId===id),"Deletion recovery removed the assigned view")
  assert(canonical(decided.backup.stores.outbox.find(e=>e.operation.operationId===original.operation.operationId))===canonical({...expected.incident.entry,state:"superseded",lease:null}),"Deletion rewrote original intention")
  for(const old of localBefore.backup.stores.syncMetadata.filter(v=>"result"in v))assert(decided.backup.stores.syncMetadata.some(v=>canonical(v)===canonical(old)),"Deletion lost frozen outcome evidence")
  for(const tag of record.tags.filter(tag=>tag.id!==id))assert(canonical(tag)===canonical(expected.observedTags.find(remote=>remote.id===tag.id)),"Deletion changed a neighboring category")
  const primary=record.tags.find(tag=>tag.id===id);assert(primary?.name===`Remote ${id}`&&primary.color==="#654321","Deletion lost reviewed remote fields")
  if(record.replacement){
   retried++
   const pending=decided.backup.stores.outbox.find(e=>e.operation.operationId===record.operationId)
   assert(pending?.state==="pending"&&pending.attempts===0&&!pending.dependencies.length&&canonical(record.replacement.command)===canonical(original.operation.command)&&record.replacement.baseRevision===2,"Deletion retry changed exact command or fresh CAS")
   const lost=await call(1,{type:"lost-plan-response-run"}) as {status:string;uploaded:number},committed=await state(),attempted=(await snapshot(1)).backup.stores.outbox.find(e=>e.operation.operationId===record.operationId)
   assert(lost.status==="retry_later"&&lost.uploaded===0&&attempted?.state==="pending"&&attempted.attempts===1&&!attempted.lease,"Lost deletion response manufactured ACK")
   assert(committed.counts.receipts===before.counts.receipts+1&&committed.page.through===before.page.through+1,"Deletion did not commit exactly once")
   await reloadSecondary();assert(canonical((await snapshot(1)).backup.stores.outbox.find(e=>e.operation.operationId===record.operationId))===canonical(attempted),"Deletion reload changed uncertain intention")
   await call(1,{type:"mixed-run"});assert(canonical(await state())===canonical(committed),"Deletion replay duplicated remote history")
   const ack=(await snapshot(1)).backup.stores.outbox.find(e=>e.operation.operationId===record.operationId)
   assert(ack?.state==="acknowledged"&&ack.attempts===2&&canonical(ack.operation)===canonical(record.replacement),"Deletion same UUID missed real replay ACK")
   lostReplies++
  }else{
   adopted++
   assert(Boolean(primary.deletedAt)===(mode==="tombstone"),"Adoption did not explicitly restore or retain the reviewed category")
  }
  await call(0,{type:"mixed-run"});await call(1,{type:"mixed-run"})
  const authoritative=await state(),projection=foldRecurringChanges(authoritative.page)
  assert(authoritative.counts.receipts===before.counts.receipts+Number(Boolean(record.replacement))&&authoritative.page.through===before.page.through+Number(Boolean(record.replacement)),"Deletion decision confirmed wrong history count")
  for(const index of [0,1]){
   const local=await snapshot(index),tags=local.backup.stores.tags
   assert(ordered(tags)===ordered([...projection.tags.values()]),"Full recovered category catalog differs from Mongo")
   for(const tag of tags){const shadow=local.backup.stores.remoteShadows.find(v=>v.entityKey===`tag:${tag.id}`);assert(shadow&&"kind"in shadow&&shadow.kind==="preference"&&shadow.record.store==="tags"&&canonical(shadow.record.record)===canonical(tag),"Deletion shadow differs from Mongo")}
   assert(local.cursor.after===authoritative.page.through&&local.cursor.through===null,"Deletion cursor did not finish")
   for(const store of ["items","itemViews","taskPlacements","occurrences","settings"] as const)assert(ordered(local.backup.stores[store])===ordered(localBefore.backup.stores[store]),"Remote deletion changed protected plans or assignments")
  }
  const later=await snapshot(1),replayed=await call(1,{type:"resolve-tag-delete",request}) as {status:string}
  assert(replayed.status==="replayed"&&canonical((await snapshot(1)).backup.stores)===canonical(later.backup.stores),"Deletion replay overwrote later confirmed state")
 }
 return {adopted,retried,lostReplies}
}
