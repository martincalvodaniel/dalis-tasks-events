"use client"

import { useContext, type ContextType } from "react"
import { SyncContext } from "@/features/sync/sync-context"
import { FixtureHookReporter } from "@fixture/hook-reporter"

export type FixtureHookEngine = NonNullable<ContextType<typeof SyncContext>>
export function FixtureHookEngine({
  report,
}: {
  account: { userId: string; epoch: string }
  report(engine: FixtureHookEngine): void
}) {
  const engine = useContext(SyncContext)
  if (!engine)
    throw new Error("Fixture requires the selected product sync provider")
  return <FixtureHookReporter engine={engine} report={report} />
}
