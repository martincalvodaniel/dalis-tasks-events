"use client"

import { createFixtureReviewInstructions } from "@fixture/review-instructions"

import { createRoot } from "react-dom/client"
import { SWRConfig } from "swr"
import { PlanOccurrenceIncidentCard } from "@/features/sync/components/plan-occurrence-incident-card"
import { requireActiveAccount } from "@/features/workspace/require-active-account"
import { readLocalRecurringBackup } from "@/lib/local-db/backup"
import { openLocalDatabase } from "@/lib/local-db/client"
import { LocalSyncStore } from "@/lib/local-db/sync-store"
import { subscribeLocalOutboxChanges } from "@/lib/local-db/sync-notifications"
import { planOccurrenceCohortResolutionRecordSchema } from "@/schemas/plan-occurrence-cohort-resolution"
import type { PlanOccurrenceCohortResolutionRecord, PlanOccurrenceCohortResolutionRequest } from "@/types/plan-occurrence-cohort-resolution"

export async function proveAppearanceCohortResolutionUi(account:{userId:string;epoch:string},request:PlanOccurrenceCohortResolutionRequest) {
  await requireActiveAccount(account)
  const container=document.createElement("aside")
  container.setAttribute("aria-label","Recuperación de fechas relacionadas de prueba")
  const instructions = createFixtureReviewInstructions(request.choice)
  document.body.append(instructions, container)
  const root=createRoot(container), database=await openLocalDatabase(account.userId), sync=await LocalSyncStore.open(account.userId)
  let chosen: PlanOccurrenceCohortResolutionRecord|null=null, unsubscribe=()=>{}, disconnect=()=>{}
  try {
    const overview=await sync.readSettingsIncidentOverview()
    const found=overview.find((value)=>value.kind==="plan-occurrence"&&value.incident.entry.operation.operationId===request.expected.source.operationId)
    if(found?.kind!=="plan-occurrence")throw new Error("Joint appearance UI requires its own current incident")
    const before=JSON.stringify((await readLocalRecurringBackup(database,account.userId,new Date().toISOString())).stores)
    const cancellationChecks: Promise<void>[]=[]
    let dialogPresent=false,openings=0,cancellations=0
    const completed=new Promise<void>((resolve,reject)=>{
      const timer=setTimeout(()=>{unsubscribe();disconnect();reject(new Error("Joint appearance UI interaction timed out"))},90000)
      const finish=()=>{
        const details=container.querySelector("details")
        if(details&&!details.open)details.open=true
        const present=Boolean(container.querySelector("dialog"))
        if(present&&!dialogPresent)openings++
        if(!present&&dialogPresent&&!chosen)cancellationChecks.push(readLocalRecurringBackup(database,account.userId,new Date().toISOString()).then((backup)=>{
          const committed=backup.stores.syncMetadata.some((value)=>"replacements" in value&&value.expected.source.operationId===request.expected.source.operationId)
          if(!committed){if(JSON.stringify(backup.stores)!==before)throw new Error("Cancelled joint appearance review changed storage");cancellations++}
        }))
        dialogPresent=present
        if(chosen&&!present){clearTimeout(timer);unsubscribe();disconnect();resolve()}
      }
      const observer=new MutationObserver(finish)
      observer.observe(container,{subtree:true,childList:true,attributes:true,characterData:true})
      disconnect=()=>observer.disconnect()
      unsubscribe=subscribeLocalOutboxChanges(account.userId,()=>{
        void readLocalRecurringBackup(database,account.userId,new Date().toISOString()).then((backup)=>{
          const value=backup.stores.syncMetadata.find((value)=>"replacements" in value&&value.expected.source.operationId===request.expected.source.operationId)
          if(value){chosen=planOccurrenceCohortResolutionRecordSchema.parse(value);finish()}
        }).catch((error)=>{clearTimeout(timer);unsubscribe();disconnect();reject(error)})
      })
    })
    root.render(<SWRConfig value={{provider:()=>new Map()}}><PlanOccurrenceIncidentCard account={account} incident={found.incident}/></SWRConfig>)
    await completed;await Promise.all(cancellationChecks);await requireActiveAccount(account)
    const record=planOccurrenceCohortResolutionRecordSchema.parse(chosen)
    if(openings<2||cancellations<1||record.choice!==request.choice||JSON.stringify(record.expected)!==JSON.stringify(request.expected)||record.resolutionId===request.resolutionId||record.operationIds.some((id)=>request.operationIds.includes(id)))throw new Error("Joint appearance UI did not cancel, reopen and create its own reviewed decision")
    return {status:"applied",record}
  } finally {unsubscribe();disconnect();root.unmount();container.remove(); instructions.remove();sync.close();database.close()}
}
