"use client"
import type { z } from "zod"
import { canonical } from "@fixture/projection"
import { nextSyncDeviceCommandSchema, nextSettingsSyncStateSchema } from "@/schemas/next-sync-test"
import { tagIncidentSnapshotSchema, tagResolutionRecordSchema } from "@/schemas/tag-resolution"
import type { LocalRecurringBackup } from "@/types/local-backup"
import type { LocalPullCursor } from "@/types/local-sync"
import type { RecurringSyncIncidentOverview } from "@/types/recurring-sync-incident"
import type { TagResolutionRequest } from "@/types/tag-resolution"

type Snapshot = { backup: LocalRecurringBackup; cursor: LocalPullCursor }
type Ports = { owner: string; call(index: number, input: z.infer<typeof nextSyncDeviceCommandSchema>): Promise<unknown>; snapshot(index: number): Promise<Snapshot>; state(): Promise<z.infer<typeof nextSettingsSyncStateSchema>>; reloadSecondary(): Promise<void> }
function assert(value: unknown, message: string): asserts value { if (!value) throw new Error(message) }
export async function proveRemoteTagRecovery({ owner, call, snapshot, state, reloadSecondary }: Ports) {
  for (const choice of ["adopt_remote", "retry_local"] as const) {
    const id = crypto.randomUUID()
    async function save(index: number, name: string, color: string, position: number) {
      return call(index, { type: "commit-local", command: { type: "tag.save", tagId: id, input: { name, color, position } } })
    }
    async function converge() {
      await call(0, { type: "mixed-run" }); await call(1, { type: "mixed-run" })
      const remote = await state()
      const effect = remote.page.changes.flatMap((change) => change.kind === "preference" ? change.effects.effects : []).filter((effect) => effect.store === "tags" && effect.record.id === id).at(-1)
      assert(effect?.store === "tags", "Remote recovered category is missing")
      for (const index of [0, 1]) {
        const local = await snapshot(index)
        const tag = local.backup.stores.tags.find((value) => value.id === id)
        const shadow = local.backup.stores.remoteShadows.find((value) => value.entityKey === `tag:${id}`)
        assert(canonical(tag) === canonical(effect.record), "Recovered category projection differs from Mongo")
        assert(shadow && "kind" in shadow && shadow.kind === "preference" && canonical(shadow.record) === canonical(effect), "Recovered category shadow differs from Mongo")
        assert(local.cursor.after === remote.page.through && local.cursor.through === null, "Recovered category cursor did not finish")
      }
    }
    await save(0, `Base ${id}`, "#123456", 30)
    await converge()
    await save(0, `Winner ${id}`, "#654321", 20)
    await call(0, { type: "mixed-run" })
    await save(1, `Draft ${id}`, "#112233", 80)
    await save(1, `Latest ${id}`, "#223344", 80)
    await call(1, { type: "mixed-run" })
    const incidents = await call(1, { type: "settings-incidents" }) as RecurringSyncIncidentOverview[]
    const found = incidents.find((value) => value.kind === "preference" && value.incident.entry.entityKey === `tag:${id}`)
    assert(found?.kind === "preference", "Real category conflict missing")
    const expected = tagIncidentSnapshotSchema.parse(found.incident)
    const request: TagResolutionRequest = { userId: owner, resolutionId: crypto.randomUUID(), operationId: choice === "retry_local" ? crypto.randomUUID() : null, choice, createdAt: new Date().toISOString(), expected }
    const guards = await call(1, { type: "tag-resolution-guard-proof", request }) as { checks: number }
    assert(guards.checks === 3, "Category feature guards not exercised")
    const before = await state(), localBefore = await snapshot(1)
    const result = await call(1, { type: "resolve-tag-ui", request }) as { status: string; record: unknown }
    const record = tagResolutionRecordSchema.parse(result.record)
    const reviewed: TagResolutionRequest = { userId: record.userId, resolutionId: record.resolutionId, operationId: record.operationId, choice: record.choice, createdAt: record.createdAt, expected: record.expected }
    assert(result.status === "applied" && canonical(await state()) === canonical(before), "Local category choice manufactured remote history")
    const decided = await snapshot(1)
    for (const original of expected.intentions.filter((value) => record.supersededOperationIds.includes(value.operation.operationId))) {
      const saved = decided.backup.stores.outbox.find((value) => value.operation.operationId === original.operation.operationId)
      assert(canonical(saved) === canonical({ ...original, state: "superseded", lease: null }), "Category choice rewrote original intention")
    }
    for (const store of ["items", "occurrences", "settings", "itemViews", "taskPlacements", "remoteShadows"] as const)
      assert(canonical(localBefore.backup.stores[store]) === canonical(decided.backup.stores[store]), "Category choice changed unrelated projections")
    if (record.replacement) {
      assert(record.local.name === `Latest ${id}` && record.local.color === "#223344" && record.local.position === 20, "Category retry lost local content or remote order")
      const lost = await call(1, { type: "lost-plan-response-run" }) as { status: string; uploaded: number }
      const pending = (await snapshot(1)).backup.stores.outbox.find((value) => value.operation.operationId === record.operationId)
      const committed = await state()
      assert(lost.status === "retry_later" && lost.uploaded === 0 && pending?.state === "pending" && pending.attempts === 1 && pending.lease === null, "Lost category reply manufactured ACK or lost intention")
      assert(committed.counts.receipts === before.counts.receipts + 1 && committed.page.through === before.page.through + 1, "Category did not commit exactly once")
      await reloadSecondary()
      const reloaded = (await snapshot(1)).backup.stores.outbox.find((value) => value.operation.operationId === record.operationId)
      assert(canonical(reloaded) === canonical(pending), "Category reload changed uncertain intent")
      await call(1, { type: "mixed-run" })
      assert(canonical(await state()) === canonical(committed), "Category replay duplicated receipt/journal")
      const ack = (await snapshot(1)).backup.stores.outbox.find((value) => value.operation.operationId === record.operationId)
      assert(ack?.state === "acknowledged" && ack.attempts === 2 && canonical(ack.operation) === canonical(record.replacement), "Category exact new UUID did not receive its real ACK")
    } else assert(record.local.name === `Winner ${id}` && record.local.position === 20, "Category adoption lost remote state")
    await converge()
    const later = await snapshot(1)
    const replay = await call(1, { type: "resolve-tag", request: reviewed }) as { status: string }
    assert(replay.status === "replayed" && canonical((await snapshot(1)).backup.stores) === canonical(later.backup.stores), "Category decision replay overwrote confirmed state")
  }
  return { adopted: true, retried: true, replayed: true }
}
