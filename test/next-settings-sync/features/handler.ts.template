import "server-only"

import { NextResponse } from "next/server"
import { getNextSyncTestConfig } from "@/config/next-sync-test"
import {
  getFixtureSyncIdentity as getProductSyncIdentity,
  getFixtureSyncChanges as getProductSyncChanges,
} from "@fixture/server-api"
import {
  bootstrapNextSyncSession,
  controlNextSettingsSyncFixtureReadiness as controlNextSyncFixtureReadiness,
  controlNextSyncSession,
  readNextSettingsSyncFixtureState as readNextSyncFixtureState,
  prepareNextSettingsSyncFixture,
  validateNextSyncFixtureRequest,
} from "@/lib/db/next-sync-fixture"
import {
  nextSyncCapabilitySchema,
  nextSyncFinishSchema,
  nextSyncPublicConfigSchema,
  nextSyncSessionCommandSchema,
} from "@/schemas/next-sync-test"
import {
  fixtureCapabilityCookieName,
  hasOwnedFixtureCapabilityCookie,
} from "@fixture/default-api"

export async function handleFixtureRequest(request: Request) {
  let phase = "request"
  try {
    const url = new URL(request.url)
    const command = url.pathname.split("/").at(-1)
    if (command === "config" && request.method === "GET") {
      let config: ReturnType<typeof getNextSyncTestConfig>
      try {
        config = getNextSyncTestConfig()
      } catch {
        return Response.json(
          { diagnostic: "private_environment_invalid" },
          { status: 403 }
        )
      }
      const capability = nextSyncCapabilitySchema.safeParse(
        Object.fromEntries(url.searchParams)
      )
      if (!capability.success || capability.data.runId !== config.runId)
        return Response.json(
          { diagnostic: "capability_invalid" },
          { status: 403 }
        )
      if (
        url.protocol !== "http:" ||
        request.headers.get("host") !== new URL(config.authOrigin).host
      )
        return Response.json(
          { diagnostic: "request_origin_mismatch" },
          { status: 403 }
        )
      return Response.json(
        nextSyncPublicConfigSchema.parse({
          runId: config.runId,
          origins: config.origins,
        }),
        { headers: { "Cache-Control": "no-store" } }
      )
    }
    const capability = { runId: request.headers.get("x-sync-test-run") }
    // Completion may report a safe foreign-cookie block; it never reads or mutates auth state.
    if (command === "finish" && request.method === "POST") {
      const config = getNextSyncTestConfig()
      const input = nextSyncFinishSchema.parse(await request.json())
      if (
        input.runId !== config.runId ||
        capability.runId !== config.runId ||
        url.protocol !== "http:" ||
        request.headers.get("host") !== new URL(config.authOrigin).host ||
        (request.headers.get("origin") !== null &&
          request.headers.get("origin") !== config.authOrigin)
      )
        return new Response(null, { status: 403 })
      const accepted = await fetch(`${config.controlOrigin}/finish`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-sync-test-run": config.runId,
        },
        body: JSON.stringify(input),
        cache: "no-store",
      })
      return new Response(null, { status: accepted.ok ? 204 : 503 })
    }
    if (command === "session" && request.method === "POST") {
      const input = nextSyncSessionCommandSchema.parse(await request.json())
      const parsedCapability = nextSyncCapabilitySchema.parse(capability)
      if (input?.runId !== parsedCapability.runId)
        return new Response(null, { status: 403 })
      const removeCapability =
        input.command === "cleanup" &&
        hasOwnedFixtureCapabilityCookie(request.headers, input.runId)
      const changed = await controlNextSyncSession(request, input)
      const response = NextResponse.json({ complete: true })
      for (const name of changed.names)
        response.cookies.set(name, "", {
          httpOnly: true,
          path: "/",
          sameSite: "lax",
          expires: new Date(0),
          maxAge: 0,
        })
      if (removeCapability)
        response.cookies.set(fixtureCapabilityCookieName(input.runId), "", {
          httpOnly: true,
          path: "/",
          sameSite: "strict",
          expires: new Date(0),
          maxAge: 0,
        })
      return response
    }
    validateNextSyncFixtureRequest(request, capability)
    if (command === "readiness" && request.method === "POST")
      return Response.json(
        await controlNextSyncFixtureReadiness(request, await request.json())
      )
    if (command === "guard" && request.method === "GET")
      return Response.json({ ready: true })
    if (command === "bootstrap" && request.method === "POST") {
      phase = "prepare"
      await prepareNextSettingsSyncFixture(request)
      const prepared = await bootstrapNextSyncSession(
        request,
        await request.json(),
        (next) => { phase = next }
      )
      const response = NextResponse.json({ userId: prepared.userId })
      const config = getNextSyncTestConfig()
      response.cookies.set(
        fixtureCapabilityCookieName(config.runId),
        config.runId,
        {
          httpOnly: true,
          path: "/",
          sameSite: "strict",
        }
      )
      for (const cookie of prepared.cookies)
        response.cookies.set(cookie.name, cookie.value, {
          httpOnly: cookie.httpOnly,
          path: cookie.path,
          secure: cookie.secure,
          sameSite: cookie.sameSite?.toLowerCase() as
            | "lax"
            | "strict"
            | "none"
            | undefined,
          expires: cookie.expires ? new Date(cookie.expires * 1000) : undefined,
        })
      return response
    }
    if (command === "legacy-identity" && request.method === "GET")
      return (
        await import("@/features/sync/identity-response")
      ).getSyncIdentityResponse(
        await (
          await import("@/features/workspace/server-identity")
        ).getWorkspaceIdentity(),
        5
      )
    if (command === "legacy-changes" && request.method === "GET")
      return (
        await import("@/features/sync/authenticated-recurring-pull")
      ).getAuthenticatedRecurringSyncChangesResponse(request)
    if (command === "identity" && request.method === "GET")
      return getProductSyncIdentity()
    if (command === "changes" && request.method === "GET")
      return getProductSyncChanges(request)
    if (command === "state" && request.method === "GET")
      return Response.json(
        await readNextSyncFixtureState(
          request,
          Object.fromEntries(url.searchParams)
        )
      )
    return new Response(null, { status: 404 })
  } catch (error) {
    const known = ["Error","MongoServerError","MongoServerSelectionError","MongoNetworkError","MongoNetworkTimeoutError","ZodError","APIError","BetterAuthError"]
    const kind = error instanceof Error && known.includes(error.name) ? error.name : "unavailable"
    const code = kind === "MongoServerError" && error && typeof error === "object" && "code" in error && typeof error.code === "number" ? error.code : null
    return Response.json(
      { error: "The isolated Next fixture was safely blocked", phase, kind, code },
      { status: 403 }
    )
  }
}
